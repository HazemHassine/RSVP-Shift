{
  "manifest_version": 3,
  "name": "Fast Reader",
  "version": "1.3.0",
  "description": "Read selected text faster, one focused word at a time.",
  "icons": {
    "16": "icons/fast-reader-16.png",
    "32": "icons/fast-reader-32.png",
    "48": "icons/fast-reader-48.png",
    "128": "icons/fast-reader-128.png"
  },
  "permissions": ["activeTab", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/fast-reader-16.png",
      "32": "icons/fast-reader-32.png",
      "48": "icons/fast-reader-48.png",
      "128": "icons/fast-reader-128.png"
    },
    "default_popup": "popup.html",
    "default_title": "Fast Reader"
  },
  "commands": {
    "toggle-reader": {
      "suggested_key": {
        "default": "Ctrl+Shift+Q",
        "mac": "Command+Shift+Q"
      },
      "description": "Toggle Fast Reader"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["settings.js", "content.js"],
      "css": ["style.css"]
    }
  ]
}
